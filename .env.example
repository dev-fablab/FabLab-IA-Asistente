# Copia este archivo a .env.local (apps/web lo lee) y completa los valores.
# Nunca versiones valores reales. Solo las variables NEXT_PUBLIC_* llegan al navegador.

# --- Web / Supabase Auth (públicas) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Servidor ---
# Conexión directa de Postgres para Drizzle. En serverless usar el pooler en modo transacción.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto firma los JWT con clave simétrica (HS256).
SUPABASE_JWT_SECRET=
# Opcional: emisor esperado de los JWT. Por defecto `<SUPABASE_URL>/auth/v1`.
# SUPABASE_JWT_ISSUER=
# Opcional: tamaño del pool de conexiones de Drizzle (por defecto 5).
# DATABASE_POOL_MAX=

# --- Modelos de chat (OpenRouter) ---
# Clave de https://openrouter.ai/keys. Mastra la toma de OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
# Modelos de chat en orden de prioridad, separados por comas, con el formato de Mastra
# (openrouter/<organización>/<modelo>). El primero es el principal; los demás son respaldos que se usan
# si falla (error 5xx, límite de tasa o tiempo agotado). Cada proveedor exige su clave (OPENROUTER_API_KEY,
# NVIDIA_API_KEY para nvidia/...).
CHAT_MODELS=openrouter/anthropic/claude-haiku-5.5,openrouter/openai/gpt-6-luna
# Tope de tokens de salida. Los modelos de razonamiento cuentan su razonamiento dentro de este tope:
# si las respuestas salen cortadas, súbelo.
# CHAT_MAX_OUTPUT_TOKENS=800

# --- Embeddings (NVIDIA NIM) ---
# Clave de https://build.nvidia.com; solo se usa para los embeddings.
NVIDIA_API_KEY=
# Modelo de embeddings de NIM. Comprueba que siga disponible: NVIDIA retira modelos (baai/bge-m3 dejó de
# existir el 2026-08-25 y responde 410 Gone) y el listado de la API incluye modelos que tu cuenta no puede usar.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# Los modelos de recuperación de NVIDIA son asimétricos: exigen `input_type` (documentos como passage y
# preguntas como query). Con `true` la app lo envía; con un modelo simétrico déjalo en `false`.
EMBEDDING_ASYMMETRIC=true
# Debe coincidir con la columna vector (1024). Si está definida, la app también se la pide al modelo
# (los modelos Matryoshka, como el anterior, permiten reducir sus 2048 dimensiones a 1024).
EMBEDDING_DIMENSION=1024

# --- Recuperación (RAG) ---
# Umbral de similitud coseno. Depende del modelo de embeddings: con llama-nemotron-embed-vl-1b-v2 las preguntas
# relevantes puntúan 0,28-0,50 y las ajenas hasta 0,10, así que 0,20 las separa (un 0,70 lo rechazaría todo).
RETRIEVAL_MIN_SCORE=0.20
RETRIEVAL_TOP_K=5

# --- Fase 2 (voz): no se usan todavía ---
# STT_MODEL=
# TTS_MODEL=
# TTS_VOICE=

# --- Registros ---
# Nivel mínimo de los registros del servidor (una línea JSON por evento): debug, info (por defecto), warn, error o silent.
# Con debug se ve, por petición del chat, cuándo llega cada tipo de chunk del modelo (chat.chunk) y los avisos de Mastra.
# LOG_LEVEL=info
