{
  "name": "fablab-assistant",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @fablab/web dev",
    "build": "pnpm --filter @fablab/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @fablab/db generate",
    "db:migrate": "pnpm --filter @fablab/db migrate",
    "db:seed-admin": "pnpm --filter @fablab/db seed-admin",
    "eval": "pnpm --filter @fablab/eval eval",
    "supabase": "supabase",
    "test:integration": "pnpm --filter @fablab/server test:integration",
    "supabase:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,postgres-meta,mailpit,supavisor",
    "supabase:stop": "supabase stop",
    "models:check": "pnpm --filter @fablab/agent models:check",
    "voice:check": "pnpm --filter @fablab/agent voice:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
